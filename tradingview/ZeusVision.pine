//@version=6
// ZeusVision — Zones Supply/Demand (portage Pine Script de mt5/ZeusP11)
//
// Port fidèle de la détection de zones déjà validée en MQL5/Python
// (ZeusZones.mqh / ZeusPivot.mqh, eux-mêmes portés de
// zeus/strategy/supply_demand/zone_detector.py + pivot_candle.py) :
//   - Score de bougie pivot (demande/offre) sur 10, 4 critères.
//   - Cassure de structure (BOS) recherchée après chaque pivot valide.
//   - Score de zone sur 10 = BOS + Impulsion + Temps + Fraîcheur + Sweep.
//   - Suivi de mitigation (une zone traversée à la clôture perd sa validité).
//
// Multi-timeframe : par défaut (InpUseChartTF=true), la détection tourne
// sur le timeframe DU GRAPHIQUE lui-même — passe le graphique en M15,
// H1, H4... et les zones se recalculent pour CE timeframe, comme un
// indicateur Supply/Demand classique. Décoche InpUseChartTF pour figer
// la détection sur un timeframe fixe (InpZoneTF, M15 par défaut = celui
// de la stratégie de production) quel que soit le graphique affiché.
//
// Priorité à la lisibilité (retour utilisateur sur la version MQL5) :
// peu de zones affichées par défaut, seulement les valides et déjà
// correctes, gros mot "DEMANDE"/"OFFRE" collé au prix actuel.
//
// En plus des zones S&D :
//   - Retracement Fibonacci tracé sur le swing de chaque zone affichée
//     (wickExtreme = 0%, extrémité opposée de l'impulsion = 100%),
//     avec la zone OTE (61.8%-78.6%) surlignée.
//   - Pattern Wyckoff (Accumulation -> Manipulation/Spring-Upthrust ->
//     MSS), port incrémental de ZeusWyckoff.mqh : une accumulation
//     candidate par barre, résolue via une file d'attente à 2 états
//     (recherche du spring, puis du MSS) pour rester O(1) par barre.
//
// ⚠️ Non testé en compilation dans cet environnement (pas d'accès à
// l'éditeur Pine de TradingView ici) — chaque fonction a été relue
// manuellement pour la syntaxe Pine v6, mais une première compilation
// réelle dans TradingView reste nécessaire avant usage. Renvoie-moi les
// éventuelles erreurs de compilation pour que je corrige.
indicator("ZeusVision — Zones Supply/Demand", overlay = true,
     max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500)

// ── Inputs ────────────────────────────────────────────────────────
grp_gen = "Général"
InpUseChartTF     = input.bool(true, "Zones sur le timeframe du graphique (change si tu changes de graphique)", group = grp_gen)
InpZoneTF         = input.timeframe("15", "Timeframe des zones fixe (utilisé seulement si l'option ci-dessus est décochée)", group = grp_gen)
InpMaxHtfBars     = input.int(1500, "Barres HTF conservées en mémoire", minval = 200, maxval = 5000, group = grp_gen)
InpMaxZonesStored = input.int(300, "Zones conservées avant purge des mitigées", minval = 20, group = grp_gen)

// Timeframe effectivement utilisé pour la détection : celui du graphique
// par défaut (l'indicateur "suit" le zoom choisi), ou une valeur fixe si
// InpUseChartTF est décoché (comportement de la version précédente,
// utile pour toujours voir les zones M15 de production quel que soit
// le graphique).
zoneTF = InpUseChartTF ? timeframe.period : InpZoneTF

grp_zone = "Affichage des zones"
InpMinZoneScoreToShow = input.float(4.0, "Score minimum affiché (0-10)", minval = 0.0, maxval = 10.0, group = grp_zone)
InpShowMitigated      = input.bool(false, "Afficher les zones mitigées (déjà traversées)", group = grp_zone)
InpMaxZonesShown      = input.int(12, "Nombre max de zones affichées", minval = 1, maxval = 100, group = grp_zone)
InpMinHeightPct       = input.float(0.05, "Hauteur visuelle minimum (% du prix)", minval = 0.0, group = grp_zone)
InpDemandColor        = input.color(color.new(color.blue, 80), "Couleur zone de demande", group = grp_zone)
InpSupplyColor        = input.color(color.new(color.red, 80), "Couleur zone d'offre", group = grp_zone)
InpDemandLabelColor   = input.color(color.navy, "Couleur texte DEMANDE", group = grp_zone)
InpSupplyLabelColor   = input.color(color.maroon, "Couleur texte OFFRE", group = grp_zone)
InpMitigatedColor     = input.color(color.new(color.gray, 88), "Couleur zone mitigée", group = grp_zone)

grp_fib = "Retracement Fibonacci (sur le swing de chaque zone)"
InpShowFibonacci  = input.bool(true, "Afficher le retracement Fibonacci sur les zones affichées", group = grp_fib)
InpShowOteZone    = input.bool(true, "Surligner la zone OTE (61.8%-78.6%, la \"golden pocket\")", group = grp_fib)
InpFibColor       = input.color(color.new(color.gray, 40), "Couleur des niveaux Fibonacci", group = grp_fib)
InpOteColor       = input.color(color.new(color.yellow, 85), "Couleur de la zone OTE", group = grp_fib)

grp_wy = "Pattern Wyckoff (Accumulation -> Manipulation -> MSS)"
InpShowWyckoff          = input.bool(true, "Afficher les patterns Wyckoff", group = grp_wy)
InpWyMinAccumBars       = input.int(3, "Barres d'accumulation minimum", minval = 1, group = grp_wy)
InpWyMaxAccumBars       = input.int(20, "Barres d'accumulation maximum", minval = 2, group = grp_wy)
InpWyAccumRangeMult     = input.float(6.0, "Multiplicateur d'amplitude d'accumulation", minval = 0.1, group = grp_wy)
InpWyMssLookback        = input.int(60, "Fenêtre de recherche spring/MSS (barres)", minval = 1, group = grp_wy)
InpWyMinSpringSweepPct  = input.float(0.05, "Sweep minimum du spring (% de l'amplitude, 0.05=XAU, 0.10=Forex)", minval = 0.0, group = grp_wy)
InpWyMinMssStrengthPct  = input.float(0.03, "Force minimum du MSS (% de l'amplitude)", minval = 0.0, group = grp_wy)
InpWyMinScoreDetect     = input.float(4.0, "Score Wyckoff minimum (détection)", group = grp_wy)
InpMinWyckoffScoreToShow = input.float(4.0, "Score minimum affiché (0-10)", minval = 0.0, maxval = 10.0, group = grp_wy)
InpMaxWyckoffShown      = input.int(15, "Nombre max de patterns affichés", minval = 1, maxval = 100, group = grp_wy)
InpMaxWyckoffStored     = input.int(150, "Patterns conservés avant purge", minval = 20, group = grp_wy)
InpWyDemandColor        = input.color(color.blue, "Couleur pattern demande (Spring)", group = grp_wy)
InpWySupplyColor        = input.color(color.red, "Couleur pattern offre (Upthrust)", group = grp_wy)
InpWyAccumColor         = input.color(color.new(color.orange, 70), "Couleur boîte d'accumulation", group = grp_wy)

grp_par = "Paramètres de détection (défauts = valeurs production)"
InpSwingLookback      = input.int(5, "Swing lookback", minval = 1, group = grp_par)
InpBosLookback        = input.int(20, "BOS lookback (recherche du niveau à casser)", minval = 1, group = grp_par)
InpBosMaxBarsDemand   = input.int(40, "BOS max bars (demande)", minval = 1, group = grp_par)
InpBosMaxBarsSupply   = input.int(80, "BOS max bars (offre)", minval = 1, group = grp_par)
InpMaxBaseCandles     = input.int(10, "Bougies de base max", minval = 1, group = grp_par)
InpMinPivotScore      = input.float(4.0, "Score pivot minimum", group = grp_par)
InpMinZoneScoreDetect = input.float(4.0, "Score zone minimum (détection)", group = grp_par)
InpAtrPeriod          = input.int(14, "Période ATR", minval = 1, group = grp_par)
InpSweepLookback      = input.int(20, "Lookback sweep (score)", minval = 3, group = grp_par)

// ── Types ─────────────────────────────────────────────────────────
type SDZone
    string side          = "demand"   // "demand" ou "supply"
    float  zoneTop       = na
    float  zoneBottom    = na
    float  wickExtreme   = na         // extrémité du pivot (bas demande / haut offre) = 0% du Fib
    float  swingExtreme  = na         // extrémité opposée de l'impulsion [pivot, BOS] = 100% du Fib
    int    formedAt      = na         // heure (ms) de la barre de BOS
    float  sBos          = 0.0
    float  sImpulse      = 0.0
    float  sTimeScore    = 0.0
    float  sFresh        = 0.0
    float  sSweep        = 0.0
    bool   isMitigated   = false
    int    touchCount    = 0

f_zoneTotal(z) =>
    z.sBos + z.sImpulse + z.sTimeScore + z.sFresh + z.sSweep

// ── Bougie pivot (port de ZeusPivot.mqh) ─────────────────────────────
f_scoreDemand(rng, body, upper, lower, bodyMid) =>
    result = 0.0
    if rng >= 1e-8
        lowerR = lower / rng
        upperR = upper / rng
        bodyR  = body / rng
        pts = math.min(4.0, lowerR * 8.0)
        pts := pts + math.max(0.0, 2.0 - bodyR * (2.0 / 0.30))
        pts := pts + math.min(2.0, bodyMid * 2.0)
        pts := pts + math.max(0.0, 2.0 - upperR * (2.0 / 0.10))
        result := math.min(10.0, pts)
    result

f_scoreSupply(rng, body, upper, lower, bodyMid) =>
    result = 0.0
    if rng >= 1e-8
        lowerR = lower / rng
        upperR = upper / rng
        bodyR  = body / rng
        pts = math.min(4.0, upperR * 8.0)
        pts := pts + math.max(0.0, 2.0 - bodyR * (2.0 / 0.30))
        pts := pts + math.min(2.0, (1.0 - bodyMid) * 2.0)
        pts := pts + math.max(0.0, 2.0 - lowerR * (2.0 / 0.10))
        result := math.min(10.0, pts)
    result

// Retourne [side, score, bodyHigh, bodyLow] ; side: "demand"/"supply"/"doji"
f_analyzeCandle(o, h, l, c) =>
    rng    = h - l
    bodyH  = math.max(o, c)
    bodyL  = math.min(o, c)
    body   = 0.0
    upper  = 0.0
    lower  = 0.0
    bodyMid = 0.5
    scoreD = 0.0
    scoreS = 0.0
    if rng >= 1e-8
        body    := bodyH - bodyL
        upper   := h - bodyH
        lower   := bodyL - l
        bodyMid := ((bodyH + bodyL) / 2.0 - l) / rng
        scoreD  := f_scoreDemand(rng, body, upper, lower, bodyMid)
        scoreS  := f_scoreSupply(rng, body, upper, lower, bodyMid)
    lowerR = rng >= 1e-8 ? lower / rng : 0.0
    upperR = rng >= 1e-8 ? upper / rng : 0.0
    lowerDominates = lowerR >= 0.25 and lowerR >= upperR * 1.5 and scoreD >= 3.0
    upperDominates = upperR >= 0.25 and upperR >= lowerR * 1.5 and scoreS >= 3.0
    side  = "doji"
    score = math.max(scoreD, scoreS)
    if lowerDominates and (not upperDominates or scoreD >= scoreS)
        side  := "demand"
        score := scoreD
    else if upperDominates
        side  := "supply"
        score := scoreS
    [side, score, bodyH, bodyL]

// ATR (rolling mean, min_periods=1 — port de ZeusComputeATR) : maintenu
// de façon INCRÉMENTALE (voir plus bas, une valeur ajoutée par nouvelle
// barre) plutôt que recalculé sur tout le tampon à chaque appel — un
// recalcul complet à chaque barre coûtait O(n) à chaque fois, soit O(n²)
// sur tout l'historique du graphique, largement au-delà du budget
// d'exécution de Pine (d'où l'erreur "script takes too long to execute").

// ── Swing detection (port de ZeusIsSwingLow/High) ───────────────────
f_isSwingLow(l, n, i, lb) =>
    startK = math.max(0, i - lb)
    endK   = math.min(n, i + lb + 1)
    mn = 1e18
    for k = startK to endK - 1
        if array.get(l, k) < mn
            mn := array.get(l, k)
    array.get(l, i) <= mn

f_isSwingHigh(h, n, i, lb) =>
    startK = math.max(0, i - lb)
    endK   = math.min(n, i + lb + 1)
    mx = -1e18
    for k = startK to endK - 1
        if array.get(h, k) > mx
            mx := array.get(h, k)
    array.get(h, i) >= mx

// ── Niveau BOS (port de la moitié "recherche du niveau" de
// ZeusFindBullishBOS/BearishBOS — la recherche FORWARD de la cassure
// n'est plus un scan ici : un pivot ne peut casser la structure que sur
// des barres qui n'existent pas encore au moment où il devient
// vérifiable (jusqu'à bosMaxBars = 40-80 barres plus tard), donc elle
// est faite de façon incrémentale, une barre à la fois, via la file
// d'attente g_pending plus bas — pas de scan répété nécessaire).
// Retourne na si aucune barre disponible pour établir le niveau.
f_scanLevel(h, l, pivotI, bosLookback, isDemand) =>
    lbStart = math.max(0, pivotI - bosLookback)
    lvl = isDemand ? -1e18 : 1e18
    ok = false
    if lbStart < pivotI
        for k = lbStart to pivotI - 1
            if isDemand
                if array.get(h, k) > lvl
                    lvl := array.get(h, k)
            else
                if array.get(l, k) < lvl
                    lvl := array.get(l, k)
        ok := true
    [ok, lvl]

// ── Scoring (port de ZeusScoreBOS/Impulse/Time/Sweep) ───────────────
f_scoreBOS(c, atr, bosBar, bosLevel, isDemand) =>
    cVal = array.get(c, bosBar)
    atrV = array.get(atr, bosBar)
    result = 1.0
    if atrV >= 1e-8
        dist  = isDemand ? (cVal - bosLevel) : (bosLevel - cVal)
        ratio = dist / atrV
        result := ratio >= 0.50 ? 2.0 : ratio >= 0.30 ? 1.5 : ratio >= 0.10 ? 1.0 : 0.5
    result

f_scoreImpulse(o, h, l, c, pivotBar, bosBar) =>
    startI = pivotBar + 1
    endI   = bosBar
    result = 1.0
    if endI >= startI
        sum = 0.0
        cnt = 0
        for i = startI to endI
            rng = array.get(h, i) - array.get(l, i)
            if rng >= 1e-8
                sum := sum + math.abs(array.get(c, i) - array.get(o, i)) / rng
                cnt := cnt + 1
        if cnt > 0
            avg = sum / cnt
            result := avg >= 0.70 ? 2.0 : avg >= 0.55 ? 1.5 : avg >= 0.40 ? 1.0 : 0.5
    result

f_scoreTime(baseCandles) =>
    baseCandles <= 2 ? 2.0 : baseCandles <= 4 ? 1.5 : baseCandles <= 6 ? 1.0 : baseCandles <= 8 ? 0.5 : 0.0

f_scoreSweep(h, l, c, pivotBar, isDemand, lookback) =>
    startI = math.max(0, pivotBar - lookback)
    cnt = pivotBar - startI
    result = 0.0
    if cnt >= 3
        tmp = array.new<float>(0)
        if isDemand
            for k = startI to pivotBar - 1
                array.push(tmp, array.get(l, k))
            ref = array.percentile_linear_interpolation(tmp, 25)
            for k = startI to pivotBar - 1
                if array.get(l, k) < ref and array.get(c, k) > ref
                    result := 2.0
        else
            for k = startI to pivotBar - 1
                array.push(tmp, array.get(h, k))
            ref = array.percentile_linear_interpolation(tmp, 75)
            for k = startI to pivotBar - 1
                if array.get(h, k) > ref and array.get(c, k) < ref
                    result := 2.0
    result

f_findBaseStart(h, l, atr, pivotBar, maxBaseCandles) =>
    avgAtr    = array.get(atr, pivotBar)
    threshold = avgAtr > 1e-8 ? avgAtr * 1.5 : 1e18
    limit  = math.max(-1, pivotBar - maxBaseCandles)
    result = math.max(0, pivotBar - maxBaseCandles)
    if pivotBar - 1 > limit
        // Pine détermine la direction en comparant les bornes (ici
        // descendante puisque pivotBar-1 > limit+1) ; "by" n'est qu'une
        // magnitude de pas et doit rester positif.
        for i = pivotBar - 1 to limit + 1 by 1
            rng = array.get(h, i) - array.get(l, i)
            if rng > threshold
                result := i + 1
                break
    result

// ── Détection INCRÉMENTALE via file d'attente de pivots ──────────────
// Contrairement au MQL5 (qui peut se permettre de rescanner tout le
// tampon à chaque barre M1, sans budget d'exécution strict), Pine limite
// le temps d'exécution total du script sur tout l'historique du
// graphique — un rescan complet à chaque nouvelle barre coûterait O(n²).
//
// Un pivot à l'indice i n'est vérifiable (fenêtre swing [i-lb, i+lb]
// complète) qu'une fois i+lb <= n-1, donc au plus tôt à i = n-1-lb —
// c'est le seul nouveau candidat par barre. Mais sa cassure de
// structure (BOS) peut survenir jusqu'à bosMaxBars (40-80) barres PLUS
// TARD, qui n'existent pas encore à ce moment — impossible de la
// chercher en un seul passage. Le niveau à casser (backward scan sur
// bosLookback barres) est calculé UNE FOIS quand le pivot est détecté,
// puis le pivot est mis en file d'attente (g_pending) ; à chaque
// nouvelle barre, un simple test O(1) par entrée en attente ("la
// clôture vient-elle de casser le niveau ?") détermine si le BOS vient
// de se produire, jusqu'à expiration après bosMaxBars barres.
type PendingPivot
    int    pivotI
    string side
    float  level
    float  bodyH
    float  bodyL
    int    expiryI       // dernier index n15 où le BOS est encore recherché

// Prix au ratio de retracement "frac" (0-1) entre wickExtreme (0%) et
// swingExtreme (100%) — même convention que zeus/strategy/smc/fibonacci.py :
// demande (bullish) : 0%=swingExtreme (haut), 100%=wickExtreme (bas) ;
// offre   (bearish)  : 0%=swingExtreme (bas),  100%=wickExtreme (haut).
f_fibPrice(wickExtreme, swingExtreme, isDemand, frac) =>
    isDemand ? swingExtreme - (swingExtreme - wickExtreme) * frac : swingExtreme + (wickExtreme - swingExtreme) * frac

// Extrémité opposée du wick sur l'impulsion [pivotI, bosBar] : le plus
// haut (demande) / le plus bas (offre) atteint pendant le mouvement qui
// a confirmé la zone — sert d'ancre 100% pour le retracement Fibonacci.
f_swingExtreme(h, l, pivotI, bosBar, isDemand) =>
    ext = isDemand ? array.get(h, pivotI) : array.get(l, pivotI)
    for i = pivotI to bosBar
        if isDemand
            if array.get(h, i) > ext
                ext := array.get(h, i)
        else
            if array.get(l, i) < ext
                ext := array.get(l, i)
    ext

f_finalizeZone(t, o, h, l, c, atr, pivotI, bodyH, bodyL, side, bosBar, bosLevel) =>
    isDemand    = side == "demand"
    baseStart   = f_findBaseStart(h, l, atr, pivotI, InpMaxBaseCandles)
    baseCandles = pivotI - baseStart + 1
    sBos    = f_scoreBOS(c, atr, bosBar, bosLevel, isDemand)
    sImp    = f_scoreImpulse(o, h, l, c, pivotI, bosBar)
    sTime   = f_scoreTime(baseCandles)
    sSweep  = f_scoreSweep(h, l, c, pivotI, isDemand, InpSweepLookback)
    sFresh  = 2.0
    total   = sBos + sImp + sTime + sFresh + sSweep
    found   = total >= InpMinZoneScoreDetect
    zone = SDZone.new(isMitigated = true)  // sentinelle si found=false
    if found
        zone := SDZone.new(
             side = side, zoneTop = bodyH, zoneBottom = bodyL,
             wickExtreme = isDemand ? array.get(l, pivotI) : array.get(h, pivotI),
             swingExtreme = f_swingExtreme(h, l, pivotI, bosBar, isDemand),
             formedAt = array.get(t, bosBar),
             sBos = sBos, sImpulse = sImp, sTimeScore = sTime,
             sFresh = sFresh, sSweep = sSweep,
             isMitigated = false, touchCount = 0)
    [found, zone]

// Met à jour touches/mitigation sur une nouvelle barre HTF close
// (port de ZeusUpdateZonesOnBar).
f_updateZonesOnBar(persistZones, barLow, barHigh, barClose, barTime) =>
    if array.size(persistZones) > 0
        for zi = 0 to array.size(persistZones) - 1
            z = array.get(persistZones, zi)
            if not z.isMitigated and barTime > z.formedAt
                inZone = barLow <= z.zoneTop and barHigh >= z.zoneBottom
                if inZone
                    z.touchCount := z.touchCount + 1
                    closedThrough = z.side == "demand" ? barClose < z.wickExtreme : barClose > z.wickExtreme
                    if closedThrough
                        z.isMitigated := true
                        z.sFresh      := 0.0
                    else if z.touchCount == 1
                        z.sFresh := 1.0

// ── Wyckoff (port incrémental de ZeusWyckoff.mqh) ────────────────────
// Le pattern Accumulation -> Manipulation (Spring/Upthrust) -> MSS est,
// dans l'original, recherché en un seul passage arrière (backward) sur
// jusqu'à 200 barres, avec un scan avant (forward) supplémentaire de
// 60 barres — même souci de performance que les zones S&D si rejoué
// barre par barre sur tout l'historique. Même stratégie : un candidat
// d'accumulation par barre (celle qui se termine à la barre courante),
// puis une machine à 2 états ("spring" -> "mss") résolue en O(1) par
// entrée en attente à chaque nouvelle barre.
type PendingAccum
    string side              // "demand" ou "supply"
    float  accumHigh
    float  accumLow
    int    accumCnt
    string phase             // "spring" (cherche le sweep) ou "mss" (cherche la cassure)
    int    springDeadline    // dernier index où chercher le spring/upthrust
    int    manipBar          // -1 tant que le spring n'est pas trouvé
    float  manipExtreme
    int    mssDeadline       // dernier index où chercher le MSS

type WyckoffPattern
    string side
    float  accumHigh
    float  accumLow
    int    accumStartAt      // approx. — voir DrawWyckoff, comme la note MQL5
    float  manipExtreme
    int    manipAt           // timestamp, PAS un index (immunisé contre les shifts du tampon)
    float  mssClose
    int    mssAt             // = formedAt
    float  score
    int    formedAt

// Fenêtre d'accumulation tendue ? Port de ZeusCheckAccum — fenêtre
// [start, accumEnd) exclusive de accumEnd, comme l'original.
f_checkAccum(h, l, accumEnd, maxAccumBars, accumRangeMult) =>
    start  = math.max(0, accumEnd - maxAccumBars)
    accumH = -1e18
    accumL = 1e18
    sumRng = 0.0
    cnt    = 0
    ok     = false
    if start < accumEnd
        for k = start to accumEnd - 1
            hk = array.get(h, k)
            lk = array.get(l, k)
            if hk > accumH
                accumH := hk
            if lk < accumL
                accumL := lk
            sumRng := sumRng + (hk - lk)
            cnt    := cnt + 1
        if cnt > 0
            accumRng = accumH - accumL
            if accumRng >= 1e-8
                avgCandle = sumRng / cnt
                if avgCandle >= 1e-8
                    ok := accumRng <= accumRangeMult * avgCandle
    [ok, accumH, accumL]

// Score Wyckoff sur 10 (port de ZeusWyckoffScore) : profondeur
// d'accumulation, ampleur du sweep, qualité de la bougie de
// manipulation, force du close MSS, vitesse de la confirmation.
f_wyckoffScore(isDemand, accumHigh, accumLow, accumCnt, o, h, l, c, si, mi, minAccumBars) =>
    accumRng = accumHigh - accumLow
    score = math.min(2.0, float(accumCnt) / minAccumBars)
    if accumRng > 1e-8
        sweep = isDemand ? math.max(0.0, accumLow - array.get(l, si)) : math.max(0.0, array.get(h, si) - accumHigh)
        score := score + math.min(2.0, (sweep / accumRng) * 4.0)
    candleRng = array.get(h, si) - array.get(l, si)
    if candleRng > 1e-8
        bodyR = math.abs(array.get(c, si) - array.get(o, si)) / candleRng
        wickR = isDemand ? math.max(0.0, accumLow - array.get(l, si)) / candleRng : math.max(0.0, array.get(h, si) - accumHigh) / candleRng
        score := score + math.min(2.0, wickR * 3.0 + math.max(0.0, 0.5 - bodyR))
    if accumRng > 1e-8
        strength = isDemand ? math.max(0.0, array.get(c, mi) - accumHigh) : math.max(0.0, accumLow - array.get(c, mi))
        score := score + math.min(2.0, (strength / accumRng) * 2.0)
    barsToMss = mi - si
    score := score + math.max(0.0, 2.0 - (barsToMss - 1) * 0.5)
    math.min(10.0, score)

// ── État persistant ───────────────────────────────────────────────
var array<SDZone>       g_zones   = array.new<SDZone>()
var array<PendingPivot> g_pending = array.new<PendingPivot>()  // pivots en attente de leur BOS
var array<int>    g_hT = array.new<int>()
var array<float>  g_hO = array.new<float>()
var array<float>  g_hH = array.new<float>()
var array<float>  g_hL = array.new<float>()
var array<float>  g_hC = array.new<float>()
var array<float>  g_tr  = array.new<float>()   // True Range par barre (pour l'ATR incrémental)
var array<float>  g_atr = array.new<float>()   // ATR incrémental, même longueur que g_hT
var float          g_atrSum = 0.0              // somme glissante des TR (fenêtre InpAtrPeriod)
var array<box>    g_boxes  = array.new<box>()
var array<label>  g_labels = array.new<label>()
var array<line>   g_fibLines = array.new<line>()
var array<label>  g_fibLabels = array.new<label>()
var array<box>    g_oteBoxes = array.new<box>()

var array<PendingAccum>   g_wyPending  = array.new<PendingAccum>()   // accumulations en cours de résolution
var array<WyckoffPattern> g_wyPatterns = array.new<WyckoffPattern>() // patterns confirmés
var array<box>    g_wyBoxes  = array.new<box>()
var array<label>  g_wyLabels = array.new<label>()

// ── Fetch HTF non-repaint (idiome standard : offset [1]) ────────────
[htfTime, htfOpen, htfHigh, htfLow, htfClose] = request.security(syminfo.tickerid, zoneTF, [time, open, high, low, close], lookahead = barmerge.lookahead_off)
newHtfBar = htfTime != htfTime[1]

if newHtfBar and not na(htfTime[1])
    // La barre qui vient de se clôturer est celle vue à l'itération
    // précédente (htfTime[1]/htfOpen[1]/...), puisque htfTime ne change
    // qu'au tout début de la barre HTF SUIVANTE.
    newT = int(htfTime[1])
    newO = htfOpen[1]
    newH = htfHigh[1]
    newL = htfLow[1]
    newC = htfClose[1]

    // TR incrémental (port de ZeusComputeATR, une valeur par barre)
    prevIdx = array.size(g_hC) - 1
    hl      = newH - newL
    trVal   = prevIdx < 0 ? hl : math.max(hl, math.max(math.abs(newH - array.get(g_hC, prevIdx)), math.abs(newL - array.get(g_hC, prevIdx))))

    array.push(g_hT, newT)
    array.push(g_hO, newO)
    array.push(g_hH, newH)
    array.push(g_hL, newL)
    array.push(g_hC, newC)
    array.push(g_tr, trVal)

    // Somme glissante sur InpAtrPeriod barres (min_periods=1, comme pandas)
    g_atrSum := g_atrSum + trVal
    if array.size(g_tr) > InpAtrPeriod
        g_atrSum := g_atrSum - array.get(g_tr, array.size(g_tr) - 1 - InpAtrPeriod)
    atrCnt = math.min(array.size(g_tr), InpAtrPeriod)
    array.push(g_atr, g_atrSum / atrCnt)

    if array.size(g_hT) > InpMaxHtfBars
        array.shift(g_hT)
        array.shift(g_hO)
        array.shift(g_hH)
        array.shift(g_hL)
        array.shift(g_hC)
        array.shift(g_tr)
        array.shift(g_atr)
        // g_pending référence des index DANS le tampon — après un shift
        // (suppression du plus ancien élément), tout index stocké doit
        // être décalé de -1 pour rester valide.
        if array.size(g_pending) > 0
            for pi = 0 to array.size(g_pending) - 1
                pp = array.get(g_pending, pi)
                pp.pivotI  := pp.pivotI - 1
                pp.expiryI := pp.expiryI - 1
        // Idem pour g_wyPending (accumulations Wyckoff en attente)
        if array.size(g_wyPending) > 0
            for wi = 0 to array.size(g_wyPending) - 1
                wp = array.get(g_wyPending, wi)
                wp.springDeadline := wp.springDeadline - 1
                if wp.manipBar >= 0
                    wp.manipBar := wp.manipBar - 1
                if wp.mssDeadline >= 0
                    wp.mssDeadline := wp.mssDeadline - 1

    n15 = array.size(g_hT)

    // Nouveau candidat pivot : celui dont la fenêtre swing [i-lb, i+lb]
    // vient tout juste de devenir complète — seul index qui n'a pas pu
    // être vérifié avant. Un pivot donné n'est ainsi jamais réévalué :
    // pas de dédup/merge nécessaire.
    pivotI = n15 - 1 - InpSwingLookback
    if pivotI >= InpSwingLookback
        [pcSide, pcScore, pcBodyH, pcBodyL] = f_analyzeCandle(array.get(g_hO, pivotI), array.get(g_hH, pivotI), array.get(g_hL, pivotI), array.get(g_hC, pivotI))
        if pcScore >= InpMinPivotScore and pcBodyH > pcBodyL
            isDemand = pcSide == "demand"
            isSupply = pcSide == "supply"
            sideOk   = false
            level    = 0.0
            maxBarsForSide = 0
            if isDemand and f_isSwingLow(g_hL, n15, pivotI, InpSwingLookback)
                [ok, lvl] = f_scanLevel(g_hH, g_hL, pivotI, InpBosLookback, true)
                sideOk := ok
                level := lvl
                maxBarsForSide := InpBosMaxBarsDemand
            else if isSupply and f_isSwingHigh(g_hH, n15, pivotI, InpSwingLookback)
                [ok, lvl] = f_scanLevel(g_hH, g_hL, pivotI, InpBosLookback, false)
                sideOk := ok
                level := lvl
                maxBarsForSide := InpBosMaxBarsSupply
            if sideOk
                expiryI  = pivotI + maxBarsForSide
                resolved = false
                // Rattrapage : la fenêtre [pivotI+1, n15-1] (<= swingLookback
                // barres) n'a encore jamais pu être vérifiée — elle est
                // déjà entièrement dans le tampon, donc bon marché à scanner.
                for j = pivotI + 1 to n15 - 1
                    if not resolved
                        cj    = array.get(g_hC, j)
                        broke = isDemand ? cj > level : cj < level
                        if broke
                            [found, zone] = f_finalizeZone(g_hT, g_hO, g_hH, g_hL, g_hC, g_atr, pivotI, pcBodyH, pcBodyL, isDemand ? "demand" : "supply", j, level)
                            if found
                                array.push(g_zones, zone)
                            resolved := true
                if not resolved and (n15 - 1) < expiryI
                    array.push(g_pending, PendingPivot.new(pivotI = pivotI, side = isDemand ? "demand" : "supply", level = level, bodyH = pcBodyH, bodyL = pcBodyL, expiryI = expiryI))

    // Résolution de la file d'attente : la cassure vient-elle de se
    // produire sur CETTE barre (test O(1) par entrée), ou l'entrée a-t-elle
    // expiré (bosMaxBars dépassé sans cassure) ?
    if array.size(g_pending) > 0
        keepPending = array.new<PendingPivot>()
        for pi = 0 to array.size(g_pending) - 1
            pp = array.get(g_pending, pi)
            ppIsDemand = pp.side == "demand"
            broke = ppIsDemand ? newC > pp.level : newC < pp.level
            if broke
                [found, zone] = f_finalizeZone(g_hT, g_hO, g_hH, g_hL, g_hC, g_atr, pp.pivotI, pp.bodyH, pp.bodyL, pp.side, n15 - 1, pp.level)
                if found
                    array.push(g_zones, zone)
            else if (n15 - 1) < pp.expiryI
                array.push(keepPending, pp)
        g_pending := keepPending

    // ── Wyckoff : nouveau candidat d'accumulation par barre ──────────
    // (celle qui se termine à la barre courante — même logique "un
    // candidat neuf par barre" que les zones S&D ci-dessus). Contrairement
    // au pivot des zones S&D, une accumulation ne dépend que du PASSÉ
    // (bornes [start, accumEnd) où accumEnd = barre courante), donc
    // vérifiable immédiatement, sans délai de confirmation.
    if InpShowWyckoff
        accumEnd = n15 - 1
        if accumEnd >= InpWyMinAccumBars
            [accOk, accH, accL] = f_checkAccum(g_hH, g_hL, accumEnd, InpWyMaxAccumBars, InpWyAccumRangeMult)
            if accOk
                accumCnt       = math.min(accumEnd, InpWyMaxAccumBars)
                springDeadline = accumEnd + InpWyMssLookback
                array.push(g_wyPending, PendingAccum.new(side = "demand", accumHigh = accH, accumLow = accL, accumCnt = accumCnt, phase = "spring", springDeadline = springDeadline, manipBar = -1, manipExtreme = na, mssDeadline = -1))
                array.push(g_wyPending, PendingAccum.new(side = "supply", accumHigh = accH, accumLow = accL, accumCnt = accumCnt, phase = "spring", springDeadline = springDeadline, manipBar = -1, manipExtreme = na, mssDeadline = -1))

        // Résolution : chaque entrée en attente avance d'une étape (ou
        // expire) sur cette barre — coût O(1) par entrée.
        if array.size(g_wyPending) > 0
            keepWy = array.new<PendingAccum>()
            cur = n15 - 1
            for wi = 0 to array.size(g_wyPending) - 1
                pa = array.get(g_wyPending, wi)
                isDemand  = pa.side == "demand"
                accumRng  = pa.accumHigh - pa.accumLow
                keep      = false
                if pa.phase == "spring"
                    springLike = isDemand ? (newL < pa.accumLow and newC > pa.accumLow) : (newH > pa.accumHigh and newC < pa.accumHigh)
                    if springLike
                        sweep    = isDemand ? (pa.accumLow - newL) : (newH - pa.accumHigh)
                        minSweep = InpWyMinSpringSweepPct * accumRng
                        if sweep >= minSweep
                            pa.phase        := "mss"
                            pa.manipBar     := cur
                            pa.manipExtreme := isDemand ? newL : newH
                            pa.mssDeadline  := cur + InpWyMssLookback
                            keep := true
                        else
                            // sweep faible : abandon direct (demande,
                            // "break" côté MQL5) ou on continue de
                            // chercher un meilleur candidat (offre,
                            // "continue" côté MQL5 — asymétrie voulue).
                            keep := isDemand ? false : cur < pa.springDeadline
                    else
                        keep := cur < pa.springDeadline
                else  // "mss"
                    broke = isDemand ? newC > pa.accumHigh : newC < pa.accumLow
                    if broke
                        strength = isDemand ? (newC - pa.accumHigh) : (pa.accumLow - newC)
                        minMss   = InpWyMinMssStrengthPct * accumRng
                        if strength >= minMss
                            wyScore = f_wyckoffScore(isDemand, pa.accumHigh, pa.accumLow, pa.accumCnt, g_hO, g_hH, g_hL, g_hC, pa.manipBar, cur, InpWyMinAccumBars)
                            if wyScore >= InpWyMinScoreDetect
                                // Conversion index -> timestamp MAINTENANT (pa.manipBar
                                // est encore un index de tampon valide à cet instant) —
                                // WyckoffPattern ne doit stocker QUE des temps/prix,
                                // jamais d'index, pour rester valide après un shift.
                                accumStartIdx = math.max(0, pa.manipBar - pa.accumCnt)
                                pattern = WyckoffPattern.new(
                                     side = pa.side, accumHigh = pa.accumHigh, accumLow = pa.accumLow,
                                     accumStartAt = array.get(g_hT, accumStartIdx),
                                     manipExtreme = pa.manipExtreme, manipAt = array.get(g_hT, pa.manipBar),
                                     mssClose = newC, mssAt = array.get(g_hT, cur),
                                     score = wyScore, formedAt = array.get(g_hT, cur))
                                array.push(g_wyPatterns, pattern)
                        // trouvé ou pas (score insuffisant) : abandonné
                        // dans les deux cas, comme l'original.
                        keep := false
                    else
                        keep := cur < pa.mssDeadline
                if keep
                    array.push(keepWy, pa)
            g_wyPending := keepWy

        // Purge : borne la taille de g_wyPatterns
        if array.size(g_wyPatterns) > InpMaxWyckoffStored
            trimmed = array.new<WyckoffPattern>()
            trimStart = array.size(g_wyPatterns) - InpMaxWyckoffStored
            for ti = trimStart to array.size(g_wyPatterns) - 1
                array.push(trimmed, array.get(g_wyPatterns, ti))
            g_wyPatterns := trimmed

    if n15 > 0
        f_updateZonesOnBar(g_zones, array.get(g_hL, n15 - 1), array.get(g_hH, n15 - 1), array.get(g_hC, n15 - 1), array.get(g_hT, n15 - 1))

    // Purge : borne la taille de g_zones en retirant les zones mitigées
    // une fois le tampon plein (comme ZeusPruneZones côté MQL5).
    if array.size(g_zones) > InpMaxZonesStored
        prunedZones = array.new<SDZone>()
        for zi = 0 to array.size(g_zones) - 1
            zz = array.get(g_zones, zi)
            if not zz.isMitigated
                array.push(prunedZones, zz)
        g_zones := prunedZones

    // ── Redessin (delete-all puis recréation, comme la version MQL5) ──
    if array.size(g_boxes) > 0
        for bi = 0 to array.size(g_boxes) - 1
            box.delete(array.get(g_boxes, bi))
        array.clear(g_boxes)
    if array.size(g_labels) > 0
        for li = 0 to array.size(g_labels) - 1
            label.delete(array.get(g_labels, li))
        array.clear(g_labels)
    if array.size(g_fibLines) > 0
        for fi = 0 to array.size(g_fibLines) - 1
            line.delete(array.get(g_fibLines, fi))
        array.clear(g_fibLines)
    if array.size(g_fibLabels) > 0
        for fi = 0 to array.size(g_fibLabels) - 1
            label.delete(array.get(g_fibLabels, fi))
        array.clear(g_fibLabels)
    if array.size(g_oteBoxes) > 0
        for oi = 0 to array.size(g_oteBoxes) - 1
            box.delete(array.get(g_oteBoxes, oi))
        array.clear(g_oteBoxes)
    if array.size(g_wyBoxes) > 0
        for oi = 0 to array.size(g_wyBoxes) - 1
            box.delete(array.get(g_wyBoxes, oi))
        array.clear(g_wyBoxes)
    if array.size(g_wyLabels) > 0
        for oi = 0 to array.size(g_wyLabels) - 1
            label.delete(array.get(g_wyLabels, oi))
        array.clear(g_wyLabels)

    // Tri par formed_at décroissant (les plus récentes en premier)
    nZones = array.size(g_zones)
    idx = array.new<int>(nZones)
    if nZones > 0
        for k = 0 to nZones - 1
            array.set(idx, k, k)
    if nZones > 1
        for a = 1 to nZones - 1
            key = array.get(idx, a)
            b = a - 1
            while b >= 0 and array.get(g_zones, array.get(idx, b)).formedAt < array.get(g_zones, key).formedAt
                array.set(idx, b + 1, array.get(idx, b))
                b := b - 1
            array.set(idx, b + 1, key)

    nowTime = array.size(g_hT) > 0 ? array.get(g_hT, array.size(g_hT) - 1) : time
    shown = 0
    if nZones > 0
        for a = 0 to nZones - 1
            if shown >= InpMaxZonesShown
                break
            z = array.get(g_zones, array.get(idx, a))
            total = f_zoneTotal(z)
            if not (z.isMitigated and not InpShowMitigated) and total >= InpMinZoneScoreToShow
                isDemand = z.side == "demand"
                col    = z.isMitigated ? InpMitigatedColor : (isDemand ? InpDemandColor : InpSupplyColor)
                lblCol = z.isMitigated ? InpMitigatedColor : (isDemand ? InpDemandLabelColor : InpSupplyLabelColor)

                dispTop    = z.zoneTop
                dispBottom = z.zoneBottom
                midPrice   = (dispTop + dispBottom) / 2.0
                minHeight  = midPrice * (InpMinHeightPct / 100.0)
                if InpMinHeightPct > 0 and (dispTop - dispBottom) < minHeight
                    pad = (minHeight - (dispTop - dispBottom)) / 2.0
                    dispTop    := dispTop + pad
                    dispBottom := dispBottom - pad

                newBox = box.new(left = z.formedAt, top = dispTop, right = nowTime, bottom = dispBottom,
                     border_color = col, bgcolor = col, border_width = z.isMitigated ? 1 : 2,
                     border_style = z.isMitigated ? line.style_dotted : line.style_solid,
                     xloc = xloc.bar_time)
                array.push(g_boxes, newBox)

                lblText = (isDemand ? "DEMANDE (" : "OFFRE (") + str.tostring(int(math.round(total))) + "/10)"
                // style_label_right : la pointe est à droite (sur nowTime),
                // le texte s'étend donc vers la GAUCHE — reste dans la zone
                // visible au lieu de partir dans l'espace vide futur.
                newLbl = label.new(x = nowTime, y = midPrice, text = lblText + " ",
                     color = color.new(color.white, 100), textcolor = lblCol,
                     style = label.style_label_right, size = size.normal,
                     xloc = xloc.bar_time)
                array.push(g_labels, newLbl)

                // ── Retracement Fibonacci sur le swing de la zone ──────
                if InpShowFibonacci and not na(z.swingExtreme)
                    fibLevels = array.from(0.236, 0.382, 0.5, 0.618, 0.786)
                    for fi = 0 to array.size(fibLevels) - 1
                        frac  = array.get(fibLevels, fi)
                        price = f_fibPrice(z.wickExtreme, z.swingExtreme, isDemand, frac)
                        fibLine = line.new(x1 = z.formedAt, y1 = price, x2 = nowTime, y2 = price,
                             color = InpFibColor, style = line.style_dotted, width = 1,
                             xloc = xloc.bar_time)
                        array.push(g_fibLines, fibLine)
                        if frac == 0.5 or frac == 0.618
                            fibLbl = label.new(x = nowTime, y = price,
                                 text = str.tostring(int(math.round(frac * 100))) + "% ",
                                 color = color.new(color.white, 100), textcolor = InpFibColor,
                                 style = label.style_label_right, size = size.tiny,
                                 xloc = xloc.bar_time)
                            array.push(g_fibLabels, fibLbl)

                    if InpShowOteZone
                        oteA = f_fibPrice(z.wickExtreme, z.swingExtreme, isDemand, 0.618)
                        oteB = f_fibPrice(z.wickExtreme, z.swingExtreme, isDemand, 0.786)
                        oteBox = box.new(left = z.formedAt, top = math.max(oteA, oteB), right = nowTime, bottom = math.min(oteA, oteB),
                             border_color = InpOteColor, bgcolor = InpOteColor, border_width = 1,
                             border_style = line.style_dotted, xloc = xloc.bar_time)
                        array.push(g_oteBoxes, oteBox)

                shown := shown + 1

    // ── Dessin des patterns Wyckoff (Accumulation -> Manipulation -> MSS) ──
    if InpShowWyckoff and array.size(g_wyPatterns) > 0
        nWy = array.size(g_wyPatterns)
        wyIdx = array.new<int>(nWy)
        for k = 0 to nWy - 1
            array.set(wyIdx, k, k)
        if nWy > 1
            for a = 1 to nWy - 1
                key = array.get(wyIdx, a)
                b = a - 1
                while b >= 0 and array.get(g_wyPatterns, array.get(wyIdx, b)).formedAt < array.get(g_wyPatterns, key).formedAt
                    array.set(wyIdx, b + 1, array.get(wyIdx, b))
                    b := b - 1
                array.set(wyIdx, b + 1, key)

        wyShown = 0
        for a = 0 to nWy - 1
            if wyShown >= InpMaxWyckoffShown
                break
            pat = array.get(g_wyPatterns, array.get(wyIdx, a))
            if pat.score >= InpMinWyckoffScoreToShow
                patIsDemand = pat.side == "demand"
                col = patIsDemand ? InpWyDemandColor : InpWySupplyColor

                // Boîte d'accumulation — approximation visuelle (voir
                // note équivalente côté MQL5 : accumStartAt est dérivé
                // de accumCnt, un écart de quelques barres est possible
                // avec la vraie fenêtre utilisée par le scoring).
                accumBox = box.new(left = pat.accumStartAt, top = pat.accumHigh, right = pat.manipAt, bottom = pat.accumLow,
                     border_color = InpWyAccumColor, bgcolor = InpWyAccumColor, border_width = 1,
                     border_style = line.style_dashed, xloc = xloc.bar_time)
                array.push(g_wyBoxes, accumBox)

                manipLbl = label.new(x = pat.manipAt, y = pat.manipExtreme,
                     text = patIsDemand ? "Spring" : "Upthrust",
                     color = color.new(color.white, 100), textcolor = col,
                     style = patIsDemand ? label.style_arrowup : label.style_arrowdown,
                     size = size.small, xloc = xloc.bar_time)
                array.push(g_wyLabels, manipLbl)

                mssLbl = label.new(x = pat.mssAt, y = pat.mssClose,
                     text = "MSS " + str.tostring(int(math.round(pat.score))) + "/10",
                     color = col, textcolor = color.white,
                     style = patIsDemand ? label.style_label_up : label.style_label_down,
                     size = size.small, xloc = xloc.bar_time)
                array.push(g_wyLabels, mssLbl)

                wyShown := wyShown + 1
