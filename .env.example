# ──────────────────────────────────────────────
# Zeus Trading Bot — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────

# Execution mode: "paper" (default) or "live"
ZEUS_MODE=paper

# Exchange identifier (ccxt id, e.g. binance, kraken, bybit)
ZEUS_EXCHANGE=binance

# API credentials — only needed in live mode
ZEUS_API_KEY=
ZEUS_API_SECRET=

# Trading pair
ZEUS_SYMBOL=BTC/USDT

# Timeframe for candles (1m, 5m, 15m, 1h, 4h, 1d)
ZEUS_TIMEFRAME=1h

# Risk parameters
ZEUS_MAX_POSITION_PCT=0.02      # max 2 % of capital per trade
ZEUS_STOP_LOSS_PCT=0.01         # 1 % stop-loss
ZEUS_TAKE_PROFIT_PCT=0.02       # 2 % take-profit
ZEUS_MAX_DAILY_LOSS_PCT=0.05    # halt if daily loss exceeds 5 %

# Paper trading initial balance (USDT)
ZEUS_PAPER_BALANCE=10000.0

# Log level: DEBUG, INFO, WARNING, ERROR
ZEUS_LOG_LEVEL=INFO
